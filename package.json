{
  "name": "tp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "dev:api": "pnpm --dir api dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "vuetify": "^4.0.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.42.0",
    "sass": "^1.98.0",
    "supertest": "^7.1.4",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
