# Même port que deployment/docker-compose.dev.yml (5433 sur l’hôte → 5432 dans le conteneur)
DATABASE_URL=postgresql://tpvuejs:devpass@127.0.0.1:5433/tpvuejs
PORT=3000

# reCAPTCHA v3 — en local, contourne l’appel Google (ignoré si NODE_ENV=production).
RECAPTCHA_SKIP_VERIFY=1

# Production : définir la vraie clé secrète (dans api/.env sur le serveur), et NE PAS mettre RECAPTCHA_SKIP_VERIFY.
# RECAPTCHA_SECRET_KEY=

# Pour tester le vrai reCAPTCHA en local : RECAPTCHA_SKIP_VERIFY=0 + RECAPTCHA_SECRET_KEY + front sans bypass + localhost autorisé sur la clé Google
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
